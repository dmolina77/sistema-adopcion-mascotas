<%- include("partials/header", {tituloWeb: "Crear nueva mascota"}) %>

<main class="container" style="max-width:600px; margin-top:40px;">
  <h1 class="mb-1">🐾 Registrar Mascota</h1>
  <p class="text-muted mb-4">Completa el formulario para agregar una mascota.</p>

  <% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>

  <form action="/mascotas" method="POST">

    <div class="mb-3">
      <label for="nombre" class="form-label fw-bold">
        Nombre <span class="text-danger">*</span>
      </label>
      <input
        type="text"
        class="form-control"
        id="nombre"
        name="nombre"
        required
        minlength="2"
        maxlength="50"
        placeholder="Ej: Firulais">
    </div>

    <div class="mb-3">
      <label for="descripcion" class="form-label fw-bold">Descripción</label>
      <textarea
        class="form-control"
        id="descripcion"
        name="descripcion"
        rows="3"
        maxlength="300"
        placeholder="Ej: Perro juguetón de 2 años..."></textarea>
      <div class="form-text">Máximo 300 caracteres. Opcional.</div>
    </div>

    <div class="row">
      <div class="col-md-4 mb-3">
        <label for="especie" class="form-label fw-bold">Especie</label>
        <select class="form-select" id="especie" name="especie">
          <option value="Perro">🐶 Perro</option>
          <option value="Gato">🐱 Gato</option>
          <option value="Conejo">🐰 Conejo</option>
          <option value="Ave">🐦 Ave</option>
          <option value="Otro" selected>🐾 Otro</option>
        </select>
      </div>
      <div class="col-md-4 mb-3">
        <label for="sexo" class="form-label fw-bold">Sexo</label>
        <select class="form-select" id="sexo" name="sexo">
          <option value="Macho">Macho</option>
          <option value="Hembra">Hembra</option>
          <option value="N/S" selected>N/S</option>
        </select>
      </div>

      <div class="col-md-4 mb-3">
        <label for="edad" class="form-label fw-bold">Edad (años)</label>
        <input
          type="number"
          class="form-control"
          id="edad"
          name="edad"
          min="0"
          max="100"
          placeholder="Ej: 3">
      </div>
    </div>

    <button type="submit" class="btn btn-success w-100 mt-2">
      ✔ Registrar Mascota
    </button>
    <a href="/mascotas" class="btn btn-outline-secondary w-100 mt-2">
      Cancelar
    </a>

  </form>
</main>

<%- include("partials/footer") %>