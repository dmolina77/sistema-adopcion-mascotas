<%- include("partials/header", {tituloWeb: "Datos de mascota" }) %>

    <div class="container">
        <h1> Datos de Mascota </h1>
        <% if (error) { %>
            <p>
                <%= mensaje %>
            </p>
            <a href="/mascotas" class="btn btn-dark w-100">Volver a Mascotas</a>
            <% } %>

                <% if (!error) { %>


                    <form id="formEditar" data-id="<%= mascota.id %>">
                        <input type="text" value="<%= mascota.nombre %>" class="form-control my-2" name="nombre"
                            id="nombreInput">
                        <input type="text" value="<%= mascota.descripcion %>" class="form-control my-2"
                            name="descripcion" id="descripcionInput">
                        <button class="btn btn-warning btn-sm w-100" type="submit">
                            Editar
                        </button>
                        <hr>
                        <button class="btn btn-danger btn-sm mt-4 float-end" type="button"  id="btnEliminar"
                            data-id="<%= mascota.id %>">
                            Eliminar
                        </button>
                    </form>




                    <!-- <table class="table">
                        <thead>
