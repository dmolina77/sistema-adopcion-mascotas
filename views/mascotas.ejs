<%- include("partials/header", {tituloWeb: "Gestión de Mascotas"}) %>

<main class="container" style="margin-top:40px;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h1 class="mb-0">🐾 Gestión de Mascotas</h1>
      <% if (usuarioActivo) { %>
        <small class="text-muted">Bienvenido, <%= usuarioActivo.nombre %></small>
      <% } %>
    </div>
    <a href="/mascotas/crear" class="btn btn-success">
      + Agregar Mascota
    </a>
  </div>

  <table class="table table-hover align-middle">
    <thead class="table-dark">
      <tr>
        <th>Nombre</th>
        <th>Especie</th>
        <th>Edad</th>
        <th>Estado</th>
        <th>Acción</th>
      </tr>
    </thead>
    <tbody>
      <% if (arrayMascotas.length > 0) { %>
        <% arrayMascotas.forEach(element => { %>
          <tr>
            <td><strong><%= element.nombre %></strong></td>
            <td><%= element.especie || 'N/A' %></td>
            <td><%= element.edad !== undefined ? element.edad + ' años' : 'N/A' %></td>
            <td>
              <% if (element.estado === 'disponible') { %>
                <span class="badge bg-success">Disponible</span>
              <% } else { %>
                <span class="badge bg-secondary">Adoptado</span>
              <% } %>
            </td>
            <td>
              <a class="btn btn-info btn-sm"
                 href="/mascotas/<%= element.id %>">
                Ver detalle
              </a>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="5" class="text-center py-5 text-muted">
            <p style="font-size:2.5rem;">🐾</p>
            <p class="fs-5">No hay mascotas registradas aún.</p>
            <a href="/mascotas/crear" class="btn btn-success">
              + Agregar primera mascota
            </a>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</main>

<%- include("partials/footer") %>