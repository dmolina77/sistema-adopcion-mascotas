<nav class="navbar navbar-expand-md navbar-dark bg-dark">
  <div class="container-fluid">
    <a class="navbar-brand" href="/">🐾 Mascotas</a>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarSupportedContent"
      aria-controls="navbarSupportedContent"
      aria-expanded="false"
      aria-label="Abrir menú">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <a class="nav-link" href="/">Inicio</a>
        </li>
        <% if (usuarioActivo) { %>
          <li class="nav-item">
            <a class="nav-link" href="/mascotas">Mascotas</a>
          </li>
        <% } %>
        <li class="nav-item">
  <a class="nav-link" href="/mascotas/razas">Razas de Perros</a>
</li>
      </ul>

      <% if (usuarioActivo) { %>
        <!-- Búsqueda conectada a ruta real -->
        <form class="d-flex me-3" role="search"
              action="/mascotas/buscar" method="GET">
          <input
            class="form-control me-2"
            type="search"
            name="q"
            placeholder="Buscar mascota..."
            aria-label="Buscar mascota">
          <button class="btn btn-outline-success" type="submit">
            Buscar
          </button>
        </form>

        <!-- Usuario activo + logout -->
        <span class="navbar-text text-light me-3">
          👤 <%= usuarioActivo.nombre %>
        </span>
        <a href="/auth/logout" class="btn btn-outline-danger btn-sm">
          Cerrar sesión
        </a>
      <% } else { %>
        <a href="/auth/login" class="btn btn-outline-light btn-sm me-2">
